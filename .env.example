# Thiếu hoặc sai biến nào thì server dừng ngay lúc khởi động (kiểm tra bằng Zod trong src/config/env.ts).

NODE_ENV=development
PORT=3000

# Chuỗi kết nối MongoDB, cần replica set (Atlas có sẵn; Docker phải bật replica set).
DATABASE_URL=mongodb://127.0.0.1:27017/cmbe?replicaSet=rs0

# Từ 32 byte ngẫu nhiên trở lên.
JWT_SECRET=
JWT_ISSUER=cmbe
JWT_AUDIENCE=cmbe-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
SESSION_MAX_AGE=90d
REFRESH_GRACE_SECONDS=10

# Danh sách origin được phép, phân tách bằng dấu phẩy (CORS, kiểm tra Origin, WebSocket).
CORS_ORIGINS=http://localhost:3001
# Cần khi chạy sau proxy Railway/Render, nếu không rate limit thấy mọi user cùng một IP.
TRUST_PROXY=false

# SameSite của cookie đăng nhập: lax khi frontend cùng site với API; none (kèm Secure) nếu khác site.
COOKIE_SAMESITE=lax

# Số lần đăng ký/đăng nhập tối đa mỗi IP trong 15 phút.
AUTH_RATE_LIMIT=20

# Gửi email (do worker gửi, nên phải chạy `npm run dev:worker`).
# log: chỉ ghi vào log, không gửi (mặc định, dùng khi phát triển). gmail: gửi thật qua SMTP của Gmail.
# Production bắt buộc gmail (hoặc nhà cung cấp khác về sau), không dùng log.
MAIL_TRANSPORT=log
# Chỉ cần khi MAIL_TRANSPORT=gmail. Dùng App Password (bật xác minh 2 bước trước, rồi tạo ở
# https://myaccount.google.com/apppasswords), KHÔNG dùng mật khẩu Gmail thường. Chỉ đặt trong file .env.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# MAIL_FROM="CardMaking <ban@gmail.com>"   # Gmail luôn ghi đè bằng tài khoản đăng nhập
# Địa chỉ trang frontend để dựng link xác nhận trong email.
FRONTEND_URL=http://localhost:3001
EMAIL_VERIFY_TTL=24h

# Bắt buộc. Redis cho BullMQ và event bus; đặt maxmemory-policy noeviction.
REDIS_URL=redis://127.0.0.1:6379

# Tiền tố khóa của mọi hàng đợi BullMQ. Redis dùng chung với dự án khác thì giữ tiền tố riêng, không dùng "bull".
QUEUE_PREFIX=cmbe

# Worker là tiến trình riêng (npm run dev:worker / npm run start:worker), nên API để false.
# Đặt true chỉ khi muốn API chạy luôn worker trong cùng tiến trình lúc phát triển.
RUN_WORKERS=false

LOG_LEVEL=info
UPLOAD_DIR=uploads
API_URL=http://localhost:3000

# Đăng nhập Google (luồng chuyển hướng, chỉ backend). Bỏ trống/để comment = tắt (GET /auth/google/start trả 503).
# Tạo "OAuth client ID" loại Web application trong Google Cloud Console, thêm CHÍNH XÁC redirect URI bên dưới.
# GOOGLE_CLIENT_SECRET là bí mật: chỉ để trong .env, không dán vào chat hay commit. Phải có cả ID lẫn secret.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Cần khi bật đăng nhập mật khẩu (gửi email).
FRONTEND_URL=http://localhost:3001
RESEND_API_KEY=
MAIL_FROM=
