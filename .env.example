# Thiếu hoặc sai biến nào thì server dừng ngay lúc khởi động (kiểm tra bằng Zod trong src/config/env.ts).

NODE_ENV=development
PORT=3000

# Chuỗi kết nối MongoDB, cần replica set (Atlas có sẵn; Docker phải bật replica set).
DATABASE_URL=mongodb://127.0.0.1:27017/cmbe?replicaSet=rs0

# Từ 32 byte ngẫu nhiên trở lên.
JWT_SECRET=
JWT_ISSUER=cmbe
JWT_AUDIENCE=cmbe-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
SESSION_MAX_AGE=90d
REFRESH_GRACE_SECONDS=10

# Danh sách origin được phép, phân tách bằng dấu phẩy (CORS, kiểm tra Origin, WebSocket).
CORS_ORIGINS=http://localhost:3001
# Cần khi chạy sau proxy Railway/Render, nếu không rate limit thấy mọi user cùng một IP.
TRUST_PROXY=false

# Bắt buộc. Redis cho BullMQ và event bus; đặt maxmemory-policy noeviction.
REDIS_URL=redis://127.0.0.1:6379

LOG_LEVEL=info
UPLOAD_DIR=uploads
API_URL=http://localhost:3000

# Cần khi bật đăng nhập Google.
GOOGLE_CLIENT_ID=

# Cần khi bật đăng nhập mật khẩu (gửi email).
FRONTEND_URL=http://localhost:3001
RESEND_API_KEY=
MAIL_FROM=
