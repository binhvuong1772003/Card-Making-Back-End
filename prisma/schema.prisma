// Schema Prisma 6 cho MongoDB: xác thực (User, Identity, Session, VerificationToken) và thiệp (Card, CardInvite, Publication, Template).
// Mongo không có TTL index qua Prisma và ta không dựa vào xóa dây chuyền: dọn phiên hết hạn do job lặp (session-cleanup.jobs.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum IdentityProvider {
  GOOGLE
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum CardRole {
  EDITOR
  VIEWER
}

// Dịp của thiệp, chọn lúc tạo thiệp. Thiệp tạo trước khi có trường này không có giá trị và được coi là OTHER.
enum CardOccasion {
  WEDDING
  BIRTHDAY
  EVENT
  OTHER
}

enum UserRole {
  USER
  ADMIN
}

// PENDING: chờ admin duyệt. PUBLISHED: đang hiện trong thư viện. REJECTED: admin từ chối (kèm lý do). UNLISTED: chủ thiệp ẩn.
// REMOVED: admin gỡ.
enum TemplateStatus {
  PENDING
  PUBLISHED
  REJECTED
  UNLISTED
  REMOVED
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique // luôn lưu chữ thường (chuẩn hóa ở service)
  emailVerifiedAt DateTime? // null = chưa xác minh; Google đặt ngay lúc tạo vì bắt buộc email_verified
  name            String?
  avatarUrl       String?
  passwordHash    String? // argon2id; null nếu chỉ đăng nhập bằng Google
  role            UserRole? // trống = USER (người dùng cũ); cấp ADMIN bằng scripts/grant-admin.ts
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  identities         Identity[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  ownedCards         Card[]              @relation("CardOwner")
  templates          Template[]          @relation("TemplateAuthor")
}

// Liên kết một User với tài khoản bên ngoài. Định danh theo `sub` của Google, không theo email.
model Identity {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  userId            String           @db.ObjectId
  provider          IdentityProvider
  providerAccountId String // `sub` của Google, bất biến
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Mỗi dòng là một refresh token. Xoay vòng: token cũ có rotatedAt + replacedById, token mới cùng familyId.
// Token cũ bị dùng lại muộn thì thu hồi cả familyId; trong cửa sổ ân hạn thì chỉ trả lỗi nhẹ.
model Session {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  familyId        String // cùng một lần đăng nhập
  tokenHash       String    @unique // SHA-256 của refresh token, không lưu token thô
  familyStartedAt DateTime // lúc đăng nhập; áp trần tuyệt đối 90 ngày cho cả họ phiên
  expiresAt       DateTime // hạn của riêng token này (30 ngày)
  rotatedAt       DateTime?
  replacedById    String?   @db.ObjectId
  revokedAt       DateTime?
  userAgent       String?
  ip              String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt]) // cho job dọn phiên hết hạn
}

// Link một lần trong email: xác minh email hoặc đặt lại mật khẩu. Chỉ lưu hash, dùng xong đặt usedAt.
model VerificationToken {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  userId    String              @db.ObjectId
  purpose   VerificationPurpose
  email     String // địa chỉ đã gửi link tới, để token không còn hợp lệ nếu sau này email đổi
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@index([expiresAt]) // để job dọn dẹp quét token hết hạn
}

// Thành viên nhúng thẳng trong Card (composite type, không phải collection riêng). Chủ sở hữu KHÔNG nằm ở đây mà ở
// Card.ownerId. Mongo không ép "mỗi user một lần" trong mảng: service phải kiểm bằng lệnh ghi có điều kiện.
// Luôn tạo Card với members: [] — bỏ trống thì trường vắng hẳn và các bộ lọc none/isEmpty/NOT some không khớp.
type CardMember {
  userId  String   @db.ObjectId
  role    CardRole
  addedAt DateTime
}

// Bản nháp đang sửa. Không có slug: slug chỉ sinh ra khi publish (nằm ở Publication).
model Card {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  ownerId          String       @db.ObjectId
  title            String
  document         Json // bản nháp: một PageData của editor (có schemaVersion); cách ghi (applyOps hay ghi cả bản) chưa chốt
  occasion         CardOccasion? // trống = OTHER (thiệp cũ); lọc OTHER phải gồm cả trường vắng
  revision         Int          @default(0) // tăng mỗi lần ghi, dùng làm điều kiện ghi
  sourceTemplateId String?      @db.ObjectId // thiệp tạo từ mẫu nào; cố ý KHÔNG là relation để gỡ mẫu không bị chặn
  members          CardMember[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  owner       User         @relation("CardOwner", fields: [ownerId], references: [id])
  invites     CardInvite[]
  publication Publication?

  @@index([ownerId, updatedAt(sort: Desc)]) // "thiệp của tôi"
  @@index([members.userId]) // "thiệp được chia sẻ với tôi"
}

// Link mời cùng sửa/xem. Chỉ lưu hash token.
model CardInvite {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  cardId      String    @db.ObjectId
  role        CardRole
  tokenHash   String    @unique
  createdById String    @db.ObjectId
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  card Card @relation(fields: [cardId], references: [id])

  @@index([cardId])
}

// Bản chụp đóng băng để XEM công khai. Chỉ tạo khi publish lần đầu; unpublish giữ nguyên dòng và slug.
// Xóa thiệp phải xóa dòng này trong cùng một transaction ở service (không dựa vào xóa dây chuyền của Prisma).
model Publication {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  cardId        String    @unique @db.ObjectId
  slug          String    @unique
  document      Json // bản chụp tại lúc publish
  publishedAt   DateTime
  unpublishedAt DateTime? // trống khi đang công khai
  indexable     Boolean   @default(false)
  ogImageUrl    String?
  listInGallery Boolean? // trống = false: chủ thiệp có gửi thiệp vào thư viện công khai không

  card Card @relation(fields: [cardId], references: [id])

  @@index([indexable, unpublishedAt]) // sitemap
}

// Bản chụp đóng băng để DÙNG LÀM MẪU. Dùng mẫu = tạo Card mới từ snapshot; từ đó mẫu và thiệp độc lập.
model Template {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  authorId         String?        @db.ObjectId // null = mẫu của hệ thống
  sourceCardId     String?        @db.ObjectId // chỉ để biết gốc; cố ý KHÔNG là relation để xóa thiệp không bị chặn
  title            String
  description      String?
  category         String
  tags             String[]
  thumbnailAssetId String?        @db.ObjectId
  snapshot         Json
  version          Int            @default(1) // tăng khi tác giả đăng lại
  status           TemplateStatus @default(PUBLISHED)
  useCount         Int            @default(0)
  rejectReason     String? // lý do admin từ chối, hiện cho chủ thiệp
  reviewedAt       DateTime?
  reviewedById     String?        @db.ObjectId
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  author User? @relation("TemplateAuthor", fields: [authorId], references: [id])

  @@index([status, publishedAt(sort: Desc)])
  @@index([category, status])
  @@index([authorId])
}
