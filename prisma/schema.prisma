// Schema Prisma 6 cho MongoDB. Hiện mới có phần xác thực; Card, CardMember, CardInvite, Publication thêm sau.
// Mongo không có TTL index qua Prisma và ta không dựa vào xóa dây chuyền: dọn phiên hết hạn do job lặp (session-cleanup.jobs.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum IdentityProvider {
  GOOGLE
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique // luôn lưu chữ thường (chuẩn hóa ở service)
  emailVerifiedAt DateTime? // null = chưa xác minh; Google đặt ngay lúc tạo vì bắt buộc email_verified
  name            String?
  avatarUrl       String?
  passwordHash    String? // argon2id; null nếu chỉ đăng nhập bằng Google
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  identities         Identity[]
  sessions           Session[]
  verificationTokens VerificationToken[]
}

// Liên kết một User với tài khoản bên ngoài. Định danh theo `sub` của Google, không theo email.
model Identity {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  userId            String           @db.ObjectId
  provider          IdentityProvider
  providerAccountId String // `sub` của Google, bất biến
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Mỗi dòng là một refresh token. Xoay vòng: token cũ có rotatedAt + replacedById, token mới cùng familyId.
// Token cũ bị dùng lại muộn thì thu hồi cả familyId; trong cửa sổ ân hạn thì chỉ trả lỗi nhẹ.
model Session {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  familyId        String // cùng một lần đăng nhập
  tokenHash       String    @unique // SHA-256 của refresh token, không lưu token thô
  familyStartedAt DateTime // lúc đăng nhập; áp trần tuyệt đối 90 ngày cho cả họ phiên
  expiresAt       DateTime // hạn của riêng token này (30 ngày)
  rotatedAt       DateTime?
  replacedById    String?   @db.ObjectId
  revokedAt       DateTime?
  userAgent       String?
  ip              String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt]) // cho job dọn phiên hết hạn
}

// Link một lần trong email: xác minh email hoặc đặt lại mật khẩu. Chỉ lưu hash, dùng xong đặt usedAt.
model VerificationToken {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  userId    String              @db.ObjectId
  purpose   VerificationPurpose
  email     String // địa chỉ đã gửi link tới, để token không còn hợp lệ nếu sau này email đổi
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@index([expiresAt]) // để job dọn dẹp quét token hết hạn
}
